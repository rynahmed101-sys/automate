{
  "schema_version": "automate.agent.v1",
  "contract_type": "machine_agent_capability_manifest",
  "project": "automate-physics",
  "purpose": "Stable machine-readable interface for AI agents using Automate as a local mathematical and physics verification working environment.",
  "compatibility": {
    "minimum_cli_version": "0.2.0",
    "transport": "process_stdio",
    "preferred_output": "json",
    "offline_core": true,
    "cloud_provider_required": false,
    "principle": "Agents provide structured untrusted mathematical claims; Automate performs representation, rule validation, backend verification, provenance binding, and certificate generation."
  },
  "discovery": {
    "command": "automate capabilities --json",
    "contract_command": "automate schema --name agent",
    "contract_file": "schemas/automate-agent-v1.json",
    "runtime_state": "capabilities --json reports optional backend/provider availability; this contract describes the interface and supported feature families."
  },
  "contracts": {
    "context": "automate.context.v1",
    "proposal": "automate.proposal.v1",
    "ir": "automate.ir.v0.2",
    "tensor": "automate-tensor-v1",
    "certificate": "automate.cert.v0.2",
    "agent": "automate.agent.v1"
  },
  "command_protocol": {
    "input_convention": "CLI arguments plus UTF-8 JSON files where a command accepts structured artifacts.",
    "output_convention": "Use --json for machine-readable output. Human-oriented commands without --json are not part of the stable machine protocol.",
    "failure_convention": "Verification failures are returned as structured status/evidence where supported; unsupported semantics must not be upgraded to verified.",
    "side_effect_rule": "Commands marked read_only do not modify the supplied derivation graph. Commands marked write_output create or update explicitly requested output artifacts."
  },
  "commands": {
    "discover": {
      "command": "automate capabilities --json",
      "mode": "read_only",
      "purpose": "Discover active backends, AI providers, rule IDs, and this contract.",
      "returns": [
        "schema_version",
        "providers",
        "rule_registry",
        "agent_contract"
      ]
    },
    "parse": {
      "command": "automate parse <theory> --json",
      "mode": "write_output",
      "purpose": "Parse declarative YAML/JSON theory into canonical derivation-graph IR.",
      "returns": [
        "status",
        "file",
        "output",
        "nodes",
        "edges",
        "assumptions"
      ]
    },
    "context": {
      "command": "automate context <theory> --json",
      "mode": "read_only",
      "purpose": "Expose sanitized mathematical state, assumptions, obligations, and available rules to an agent.",
      "returns_contract": "automate.context.v1"
    },
    "validate": {
      "command": "automate validate <proposal> --theory <theory> --json",
      "mode": "read_only",
      "purpose": "Validate an untrusted proposal against schema, security rules, graph dependencies, and approved transformation rules.",
      "returns": [
        "is_valid",
        "errors",
        "proposal"
      ]
    },
    "propose_dry_run": {
      "command": "automate propose <theory> --proposal <proposal> --dry-run --json",
      "mode": "read_only",
      "purpose": "Inject an AI proposal into a cloned graph, synthesize obligations, and run applicable verification without changing the canonical graph.",
      "returns": [
        "success",
        "status",
        "edge_id",
        "report",
        "graph_updated"
      ]
    },
    "propose_apply": {
      "command": "automate propose <theory> --proposal <proposal> --output <graph> --json",
      "mode": "write_output",
      "purpose": "Apply and verify a validated proposal, attach evidence/certificate state, and persist the updated graph to the requested output path.",
      "returns": [
        "success",
        "status",
        "edge_id",
        "report"
      ]
    },
    "research": {
      "command": "automate research <theory> --provider <mock|openai|local> --max-steps <n> --output-dir <dir> --json",
      "mode": "write_output",
      "purpose": "Run a bounded proposal/validation/verification research loop.",
      "returns": [
        "total_steps",
        "trace",
        "graph_file"
      ],
      "bounds": [
        "max_steps"
      ]
    },
    "check": {
      "command": "automate check <graph> --json",
      "mode": "read_only",
      "purpose": "Run symbolic and dimensional checks applicable to graph edges.",
      "returns": "per-edge verification summary"
    },
    "prove": {
      "command": "automate prove <graph> --json",
      "mode": "read_only",
      "purpose": "Run Lean 4 formal proof checks on edges configured for the Lean backend.",
      "availability": "optional runtime dependency",
      "returns": "per-edge formal verification summary"
    },
    "simulate": {
      "command": "automate simulate <graph> --json",
      "mode": "read_only",
      "purpose": "Run bounded SciPy RK45 ODE integration and numerical evidence checks.",
      "returns": "per-edge numerical verification summary"
    },
    "stats": {
      "command": "automate stats <graph> --json",
      "mode": "read_only",
      "purpose": "Run empirical parameter estimation, uncertainty diagnostics, and chi-square goodness-of-fit checks where configured.",
      "returns": "per-edge statistical verification summary"
    },
    "query_assumptions": {
      "command": "automate query-assumptions <graph> [--drop <assumption_id>] --json",
      "mode": "read_only",
      "purpose": "Inspect assumption dependencies or simulate removal of a specific assumption.",
      "returns": "assumption dependency or invalidation impact report"
    },
    "expand": {
      "command": "automate expand <graph> --edge <edge_id>",
      "mode": "read_only",
      "purpose": "Losslessly expand a composite derivation edge into certificate micro-steps."
    },
    "visualize": {
      "command": "automate visualize <graph> --output <html>",
      "mode": "write_output",
      "purpose": "Generate a standalone interactive HTML derivation graph visualization."
    },
    "report": {
      "command": "automate report <graph> --json",
      "mode": "read_only",
      "purpose": "Return the canonical graph and verification state matrix as JSON."
    },
    "export_certificate": {
      "command": "automate export-certificate <graph> --output-dir <dir> --json",
      "mode": "write_output",
      "purpose": "Export the machine-auditable certificate package and cryptographic manifest.",
      "returns": "artifact file map"
    },
    "schema": {
      "command": "automate schema --name <ir|tensor|proposal|context|agent>",
      "mode": "read_only",
      "purpose": "Retrieve authoritative interchange schemas and this machine-agent capability contract."
    },
    "demo": {
      "command": "automate demo --output-dir <dir>",
      "mode": "write_output",
      "purpose": "Run the canonical end-to-end harmonic oscillator demonstration.",
      "machine_protocol": false
    }
  },

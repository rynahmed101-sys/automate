  "ai_workflow": {
    "sequence": [
      "discover capabilities",
      "retrieve controlled context",
      "construct automate.proposal.v1",
      "validate untrusted proposal",
      "dry-run proposal",
      "apply only when appropriate",
      "inspect evidence and status",
      "export certificate when a durable audit artifact is needed"
    ],
    "result_fields_recommended_to_agents": [
      "status",
      "operation",
      "result",
      "verification_method",
      "independence",
      "provenance",
      "certificate"
    ],
    "important_semantics": {
      "verified": "Evidence-derived status from an applicable backend.",
      "unverified": "Insufficient evidence; not equivalent to false.",
      "unsupported": "The current rule/backend does not represent enough semantics to perform the requested check.",
      "failed": "A check ran and the claim did not pass or an execution error prevented verification.",
      "caller_output": "A caller-supplied expected result is not independent evidence."
    }
  },
  "providers": {
    "mock": {
      "availability": "intended for deterministic offline tests"
    },
    "local": {
      "availability": "runtime-configured local HTTP endpoint",
      "security_boundary": "external model output is still untrusted"
    },
    "openai": {
      "availability": "runtime-configured credentials/endpoint",
      "security_boundary": "external model output is still untrusted"
    }
  },
  "artifacts": {

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automate.physics/schemas/automate-capability-inventory-v1.json",
  "title": "Automate Capability Evidence Inventory (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "authoritative_branch",
    "roadmap_authority",
    "inventory_purpose",
    "authoritative_verification",
    "capabilities"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "automate.capability_inventory.v1"
    },
    "authoritative_branch": {
      "const": "main"
    },
    "roadmap_authority": {
      "type": "string",
      "minLength": 1
    },
    "inventory_purpose": {
      "type": "string",
      "minLength": 1
    },
    "authoritative_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "main_sha",
        "exact_head_workflow_run",
        "exact_head_conclusion",
        "security_workflow_run",
        "security_conclusion",
        "local_test_summary",
        "note"
      ],
      "properties": {
        "main_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "exact_head_workflow_run": {
          "type": "integer",
          "minimum": 1
        },
        "exact_head_conclusion": {
          "type": "string"
        },
        "security_workflow_run": {
          "type": "integer",
          "minimum": 1
        },
        "security_conclusion": {
          "type": "string"
        },
        "local_test_summary": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "implementation_state",
          "interfaces",
          "canonical_files",
          "tests",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "implementation_state": {
            "enum": [
              "implemented",
              "partially_implemented",
              "active_development",
              "not_directly_exposed",
              "historical"
            ]
          },
          "interfaces": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "python",
                "cli",
                "structured_request",
                "graph_ir",
                "schema"
              ]
            }
          },
          "operations": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "canonical_files": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "tests": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "number",
                "state"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "pr",
                    "issue"
                  ]
                },
                "number": {
                  "type": "integer",
                  "minimum": 1
                },
                "state": {
                  "type": "string"
                }
              }
            }
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "locally_tested",
              "development_ci_verified",
              "merged_main",
              "exact_head_verified",
              "security_audit_verified",
              "independently_cross_checked",
              "formally_proved",
              "certified"
            ],
            "properties": {
              "locally_tested": {
                "type": "boolean"
              },
              "development_ci_verified": {
                "type": "boolean"
              },
              "merged_main": {
                "type": "boolean"
              },
              "exact_head_verified": {
                "type": "boolean"
              },
              "security_audit_verified": {
                "type": "boolean"
              },
              "independently_cross_checked": {
                "type": "boolean"
              },
              "formally_proved": {
                "type": "boolean"
              },
              "certified": {
                "type": "boolean"
              }
            }
          },
          "verification_evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "main_sha"
            ],
            "properties": {
              "main_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "exact_head_workflow_run": {
                "type": "integer",
                "minimum": 1
              },
              "security_workflow_run": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}

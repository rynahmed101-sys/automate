{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automate.physics/schemas/automate-ecosystem-manifest-v1.json",
  "title": "Automate Scientific Ecosystem Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","authority","components","trust_ladder"],
  "properties": {
    "schema_version": {"const":"automate.ecosystem.v1"},
    "authority": {"const":"automate"},
    "components": {
      "type":"object",
      "additionalProperties": false,
      "required":["automate","worker","mirror"],
      "properties": {
        "automate":{"type":"object","required":["role","repository"],"additionalProperties":false,"properties":{"role":{"const":"authority"},"repository":{"const":"rynahmed101-sys/automate"}}},
        "worker":{"type":"object","required":["role","repository"],"additionalProperties":false,"properties":{"role":{"const":"execution"},"repository":{"const":"rynahmed101-sys/chanfana-openapi-template"}}},
        "mirror":{"type":"object","required":["role","repository"],"additionalProperties":false,"properties":{"role":{"const":"laboratory"},"repository":{"const":"rynahmed101-sys/the-mirror"}}}
      }
    },
    "trust_ladder": {
      "type":"array","items":{"type":"string"},
      "minItems":8
    }
  }
}
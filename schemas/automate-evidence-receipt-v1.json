{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automate.physics/schemas/automate-evidence-receipt-v1.json",
  "title": "Automate Evidence Receipt (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","receipt_id","action","repository","observed_at","trust_state","evidence"],
  "properties": {
    "schema_version": {"const":"automate.evidence_receipt.v1"},
    "receipt_id": {"type":"string","minLength":8,"maxLength":128},
    "action": {"type":"string","minLength":1,"maxLength":200},
    "repository": {
      "type":"object","additionalProperties":false,
      "required":["full_name","base_sha"],
      "properties":{
        "full_name":{"type":"string","minLength":1},
        "base_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
        "branch":{"type":["string","null"]},
        "pr_number":{"type":["integer","null"],"minimum":1},
        "merge_sha":{"type":["string","null"],"pattern":"^[0-9a-f]{40}$"}
      }
    },
    "observed_at":{"type":"string","minLength":1},
    "trust_state":{
      "type":"string",
      "enum":["PLANNED","IMPLEMENTED","LOCALLY_TESTED","DEV_CI_VERIFIED","MERGED_MAIN","EXACT_HEAD_VERIFIED","SECURITY_VERIFIED","INDEPENDENTLY_CROSS_CHECKED","CERTIFIED"]
    },
    "evidence":{
      "type":"object","additionalProperties":false,
      "required":["items"],
      "properties":{
        "items":{
          "type":"array","maxItems":100,
          "items":{"type":"object","additionalProperties":false,"required":["kind","status"],"properties":{
            "kind":{"type":"string","minLength":1,"maxLength":100},
            "status":{"type":"string","enum":["passed","failed","skipped","observed","unknown"]},
            "reference":{"type":["string","null"],"maxLength":500},
            "detail":{"type":["string","null"],"maxLength":4000}
          }}
        }
      }
    },
    "unresolved":{"type":"array","maxItems":50,"items":{"type":"string","maxLength":2000}}
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automate.physics/schemas/automate-evidence-receipt-v1.json",
  "title": "Automate Evidence Receipt (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "action",
    "repository",
    "observed_at",
    "trust_state",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "automate.evidence_receipt.v1"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_name",
        "base_sha"
      ],
      "properties": {
        "full_name": {
          "type": "string",
          "minLength": 1
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "pr_number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "merge_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "observed_at": {
      "type": "string",
      "minLength": 1
    },
    "trust_state": {
      "type": "string",
      "enum": [
        "PLANNED",
        "IMPLEMENTED",
        "LOCALLY_TESTED",
        "DEV_CI_VERIFIED",
        "IMPLEMENTATION_VERIFIED",
        "MERGED_MAIN",
        "EXACT_HEAD_VERIFIED",
        "SECURITY_VERIFIED",
        "INDEPENDENTLY_CROSS_CHECKED",
        "CERTIFIED"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "status"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "skipped",
                  "observed",
                  "unknown"
                ]
              },
              "reference": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 500
              },
              "detail": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 4000
              }
            }
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "action_cycle_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "target": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "packet_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "result_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "file_hashes": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tests": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "ci_run_ids": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "security_run_ids": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "independent_checks": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "final_exact_head_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "capability_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "job_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "experiment_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "source": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "provider",
        "source"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "retrieved_at": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "revision": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "limitations": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    }
  }
}

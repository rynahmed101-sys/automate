{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://automate.physics/schemas/automate-control-plane-pin-v1.json",
  "title":"Automate Control Plane Pin (v1)",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","enabled","engine_sha","auto_promote","notes"],
  "properties":{
    "schema_version":{"const":"automate.control_plane_pin.v1"},
    "enabled":{"type":"boolean"},
    "engine_sha":{"type":["string","null"],"pattern":"^[0-9a-f]{40}$"},
    "auto_promote":{"type":"boolean"},
    "notes":{"type":"string"}
  }
}
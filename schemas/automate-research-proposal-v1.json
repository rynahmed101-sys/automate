{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automate.physics/schemas/automate-research-proposal-v1.json",
  "title": "Automate Research Proposal Intake (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority",
    "proposal_id",
    "request_id",
    "capability_id",
    "source_revision",
    "candidate_capability",
    "evidence_refs",
    "assumptions",
    "risks",
    "limitations",
    "status"
  ],
  "properties": {
    "schema_version": {"const":"mirror.research_proposal.v1"},
    "authority": {"const":"UNTRUSTED_RESEARCH_PROPOSAL"},
    "proposal_id": {"type":"string","pattern":"^proposal_[0-9a-f]{32}$"},
    "request_id": {"type":"string","minLength":8,"maxLength":128},
    "capability_id": {"type":"string","minLength":1,"maxLength":256},
    "source_revision": {"type":["string","null"],"pattern":"^[0-9a-f]{40}$"},
    "candidate_capability": {
      "type":"object",
      "additionalProperties":false,
      "required":["id","name","summary","prerequisites","dependencies"],
      "properties":{
        "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9_.-]*$"},
        "name":{"type":"string","minLength":1,"maxLength":500},
        "summary":{"type":"string","minLength":1,"maxLength":10000},
        "prerequisites":{"type":"array","items":{"type":"string"},"maxItems":100},
        "dependencies":{"type":"array","items":{"type":"string"},"maxItems":100}
      }
    },
    "evidence_refs":{"type":"array","minItems":1,"maxItems":100,"items":{"type":"string","minLength":1,"maxLength":2000}},
    "assumptions":{"type":"array","maxItems":100,"items":{"type":"string","maxLength":2000}},
    "risks":{"type":"array","maxItems":100,"items":{"type":"string","maxLength":2000}},
    "limitations":{"type":"array","maxItems":100,"items":{"type":"string","maxLength":2000}},
    "status":{"const":"CANDIDATE"}
  }
}

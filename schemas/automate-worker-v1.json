{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automate.physics/schemas/automate-worker-v1.json",
  "title": "Automate Autonomous Worker Contract (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet"],
  "properties": {
    "schema_version": {"const": "automate.worker.v1"},
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind","request_id","repository","capability","constraints","instructions","verification"],
      "properties": {
        "kind": {"const": "capability_implementation"},
        "request_id": {"type":"string","minLength":8,"maxLength":128},
        "repository": {
          "type":"object","additionalProperties":false,
          "required":["full_name","base_branch"],
          "properties":{
            "full_name":{"type":"string","minLength":1},
            "base_branch":{"const":"main"},
            "base_sha_claim":{"type":["string","null"]}
          }
        },
        "capability": {
          "type":"object",
          "additionalProperties":false,
          "required":["id","stage","name","dependencies"],
          "properties":{
            "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9_.-]*$"},
            "stage":{"type":"string","minLength":1},
            "name":{"type":"string","minLength":1},
            "dependencies":{"type":"array","items":{"type":"string"}}
          }
        },
        "constraints":{
          "type":"object",
          "additionalProperties":false,
          "required":["allowed_path_prefixes","forbidden_paths","branch_prefix","max_files","allow_delete"],
          "properties":{
            "allowed_path_prefixes":{"type":"array","items":{"type":"string"}},
            "forbidden_paths":{"type":"array","items":{"type":"string"}},
            "branch_prefix":{"const":"feat/"},
            "max_files":{"type":"integer","minimum":1,"maximum":100},
            "allow_delete":{"const":false}
          }
        },
        "instructions":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
        "verification":{
          "type":"object","additionalProperties":false,
          "required":["must_run_tests","must_report_unresolved","must_not_claim_certification"],
          "properties":{
            "must_run_tests":{"const":true},
            "must_report_unresolved":{"const":true},
            "must_not_claim_certification":{"const":true}
          }
        }
      }
    }
  }
}

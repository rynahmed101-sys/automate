{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://automate.physics/schemas/automate-verification-request-v1.json",
  "title":"Automate Verification Request (v1)",
  "type":"object","additionalProperties":false,
  "required":["schema_version","action_cycle_id","request_id","capability_id","repository","revision","branch","scope","parent_ids"],
  "properties":{
    "schema_version":{"const":"automate.verification_request.v1"},
    "action_cycle_id":{"type":"string","minLength":8,"maxLength":128},
    "request_id":{"type":"string","pattern":"^ver_[0-9a-f]{32}$"},
    "capability_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9_.-]*$"},
    "repository":{"type":"string","minLength":1,"maxLength":200},
    "revision":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "branch":{"type":"string","minLength":1,"maxLength":255},
    "scope":{"type":"array","minItems":1,"maxItems":50,"items":{"type":"string","minLength":1,"maxLength":200}},
    "parent_ids":{"type":"array","maxItems":50,"items":{"type":"string","minLength":1,"maxLength":128}}
  }
}
{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://automate.physics/schemas/automate-verifiable-packet-v1.json",
  "title":"Automate Verifiable Evidence Packet (v1)",
  "type":"object","additionalProperties":false,
  "required":["schema_version","packet_id","action_cycle_id","capability_id","repository","exact_commit_sha","branch","tests","ci_run_ids","security_run_ids","verifier_version","rule_set_hash","mathematical_evidence","computational_evidence","data_provenance_evidence","mirror_experiment_ids","external_source_ids","assumptions","tolerances","repair_history","unresolved","limitations","evidence_graph_ids","authority"],
  "properties":{
    "schema_version":{"const":"automate.verifiable_packet.v1"},
    "packet_id":{"type":"string","pattern":"^pkt_[0-9a-f]{32}$"},
    "action_cycle_id":{"type":"string","minLength":8,"maxLength":128},
    "capability_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9_.-]*$"},
    "job_id":{"type":["string","null"],"maxLength":128},
    "result_ids":{"type":"array","maxItems":100,"items":{"type":"string","maxLength":128}},
    "repository":{"type":"string","minLength":1,"maxLength":200},
    "evidence_state":{"type":"string","enum":["UNVERIFIED","IN_PROGRESS","VERIFIED","PARTIALLY_SUPPORTED","REPRODUCED","CONTRADICTED","UNRESOLVED","FALSE","BLOCKED","QUARANTINED"]},
    "exact_commit_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "tree_sha":{"type":["string","null"],"maxLength":128},
    "branch":{"type":"string","minLength":1,"maxLength":255},
    "pr_number":{"type":["integer","null"],"minimum":1},
    "changed_file_hashes":{"type":"array","maxItems":200,"items":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","maxLength":500},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}},
    "tests":{"type":"array","maxItems":100,"items":{"type":"string","maxLength":1000}},
    "ci_run_ids":{"type":"array","maxItems":50,"items":{"type":"integer","minimum":1}},
    "security_run_ids":{"type":"array","maxItems":20,"items":{"type":"integer","minimum":1}},
    "verifier_version":{"type":"string","minLength":1,"maxLength":100},
    "rule_set_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "mathematical_evidence":{"type":"object"},
    "computational_evidence":{"type":"object"},
    "data_provenance_evidence":{"type":"object"},
    "mirror_experiment_ids":{"type":"array","maxItems":50,"items":{"type":"string","maxLength":128}},
    "external_source_ids":{"type":"array","maxItems":100,"items":{"type":"string","maxLength":500}},
    "assumptions":{"type":"array","maxItems":100,"items":{"type":"string","maxLength":2000}},
    "tolerances":{"type":"object"},
    "repair_history":{"type":"array","maxItems":50,"items":{"type":"object"}},
    "unresolved":{"type":"array","maxItems":100,"items":{"type":"string","maxLength":2000}},
    "limitations":{"type":"array","maxItems":100,"items":{"type":"string","maxLength":2000}},
    "evidence_graph_ids":{"type":"array","maxItems":200,"items":{"type":"string","maxLength":128}},
    "authority":{"const":"EVIDENCE_ONLY"}
  }
}
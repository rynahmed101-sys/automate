{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automate.physics/schemas/automate-system-evolution-plan-v1.json",
  "title": "Automate System Evolution Plan (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "proposal_id",
    "base_revision",
    "kind",
    "allowed_path_prefixes",
    "changes",
    "regression_requirements",
    "rollback",
    "apply_mode"
  ],
  "properties": {
    "schema_version": {"const":"automate.system_evolution_plan.v1"},
    "plan_id": {"type":"string","pattern":"^evoplan_[0-9a-f]{32}$"},
    "proposal_id": {"type":"string","pattern":"^evo_[0-9a-f]{32}$"},
    "base_revision": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "kind": {"enum":["knowledge","strategy","verifier","capability"]},
    "allowed_path_prefixes": {"type":"array","minItems":1,"maxItems":20,"items":{"type":"string","minLength":1},"uniqueItems":true},
    "changes": {
      "type":"array","minItems":1,"maxItems":20,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["path","operation","expected_sha","content"],
        "properties":{
          "path":{"type":"string","minLength":1,"maxLength":500},
          "operation":{"enum":["create","update"]},
          "expected_sha":{"type":["string","null"],"pattern":"^[0-9a-f]{40}$"},
          "content":{"type":"string","maxLength":100000}
        }
      }
    },
    "regression_requirements":{"type":"array","minItems":1,"maxItems":100,"items":{"type":"string","minLength":1}},
    "rollback":{"type":"string","minLength":1,"maxLength":10000},
    "apply_mode":{"const":"proposal_only"}
  }
}

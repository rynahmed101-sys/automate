{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automate.physics/schemas/automate-learning-lesson-v1.json",
  "title": "Automate Learning Lesson (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lesson_id",
    "lesson_type",
    "statement",
    "scope",
    "preconditions",
    "expected_effect",
    "supporting_experience_ids",
    "verification_evidence",
    "status",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "automate.learning_lesson.v1"},
    "lesson_id": {"type": "string", "pattern": "^les_[0-9a-f]{32}$"},
    "lesson_type": {"enum": ["failure", "success", "strategy", "constraint", "scientific", "hypothesis", "system_improvement"]},
    "statement": {"type": "string", "minLength": 1, "maxLength": 20000},
    "scope": {"type": "object", "additionalProperties": true},
    "preconditions": {"type": "array", "items": {"type": "string"}, "maxItems": 100},
    "expected_effect": {"type": "string", "maxLength": 10000},
    "supporting_experience_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^exp_[0-9a-f]{32}$"}
    },
    "verification_evidence": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "object", "additionalProperties": true}
    },
    "status": {
      "enum": ["CANDIDATE", "REPRODUCED", "VERIFIED", "ADOPTED", "SUPERSEDED", "REJECTED", "CONTEXT_BOUND", "UNKNOWN"]
    },
    "provenance": {"type": "object", "additionalProperties": true}
  }
}

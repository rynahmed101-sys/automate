{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automate.physics/schemas/automate-system-evolution-proposal-v1.json",
  "title": "Automate System Evolution Proposal (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "kind",
    "classification",
    "subject",
    "rationale",
    "expected_benefit",
    "evidence_refs",
    "regression_requirements",
    "rollback",
    "status",
    "auto_promotable",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "automate.system_evolution_proposal.v1"},
    "proposal_id": {"type": "string", "pattern": "^evo_[0-9a-f]{32}$"},
    "kind": {"enum": ["knowledge", "strategy", "verifier", "capability", "governance"]},
    "classification": {"enum": ["MUTABLE", "CONSTITUTIONAL"]},
    "subject": {"type": "string", "minLength": 1, "maxLength": 1000},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 20000},
    "expected_benefit": {"type": "string", "minLength": 1, "maxLength": 10000},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"type": "object", "required": ["id"], "additionalProperties": true, "properties": {"id": {"type": "string"}}}
    },
    "regression_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}, "maxItems": 100},
    "rollback": {"type": "string", "minLength": 1, "maxLength": 10000},
    "status": {"enum": ["CANDIDATE", "VERIFIED", "ADOPTED", "REJECTED", "SUPERSEDED"]},
    "auto_promotable": {"type": "boolean"},
    "provenance": {"type": "object", "additionalProperties": true}
  },
  "allOf": [
    {
      "if": {"properties": {"classification": {"const": "CONSTITUTIONAL"}}},
      "then": {"properties": {"auto_promotable": {"const": false}}}
    }
  ]
}

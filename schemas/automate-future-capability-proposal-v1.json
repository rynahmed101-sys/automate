{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automate.physics/schemas/automate-future-capability-proposal-v1.json",
  "title": "Automate Future Capability Proposal (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "candidate_capability",
    "triage",
    "suggested_stage",
    "suggested_order",
    "required_next_steps",
    "authority",
    "canonical_ledger_mutated",
    "future_capability_id",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "automate.future_capability_proposal.v1"
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "future_capability_id": {
      "type": "string",
      "pattern": "^fcap_[0-9a-f]{32}$"
    },
    "candidate_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "summary",
        "dependencies",
        "prerequisites"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "triage": {
      "type": "object"
    },
    "suggested_stage": {
      "type": "string",
      "minLength": 1
    },
    "suggested_order": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "required_next_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority": {
      "const": "UNTRUSTED_FUTURE_CAPABILITY_PROPOSAL"
    },
    "canonical_ledger_mutated": {
      "const": false
    },
    "status": {
      "const": "CANDIDATE"
    }
  }
}
